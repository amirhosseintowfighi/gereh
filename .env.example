# ---- core ----
# PostgreSQL in production. Without it the app uses embedded PGlite (PGLITE_DIR on disk, else in-memory).
DATABASE_URL=postgres://gereh:password@localhost:5432/gereh
# PGLITE_DIR=.data/pglite
# ≥32 random chars; encrypts secrets entered in the admin panel (Virtualizor pass, SMS key)
APP_SECRET=
# first owner account, created on an empty database
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# 1 = add demo customers/services on first boot (default: on outside production)
SEED_DEMO=0
# set when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=1
NEXT_PUBLIC_SITE_URL=https://gereh.cloud
# show one-click demo logins on /auth (staging only)
NEXT_PUBLIC_DEMO=0

# ---- Virtualizor (or enter them in Admin › اتصال Virtualizor) ----
VIRTUALIZOR_HOST=
VIRTUALIZOR_KEY=
VIRTUALIZOR_PASS=
# VIRTUALIZOR_PORT=4085
# VIRTUALIZOR_ENDUSER_PORT=4083
# adminapikey (default) or apikey — confirm against /usr/local/virtualizor/sdk/admin.php
# VIRTUALIZOR_AUTH=adminapikey
# 0 accepts the panel's self-signed certificate
# VIRTUALIZOR_TLS_STRICT=1

# ---- payments (none configured → test gateway outside production) ----
ZARINPAL_MERCHANT=
# ZARINPAL_SANDBOX=1
IDPAY_API_KEY=
# IDPAY_SANDBOX=1
# PAY_SIMULATOR=1

# ---- SMS / email (none configured → messages go to an in-memory outbox) ----
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=gereh-otp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="گره <no-reply@gereh.cloud>"
CONTACT_INBOX=hello@gereh.cloud
# DevOps consultation requests (defaults to CONTACT_INBOX)
DEVOPS_INBOX=devops@gereh.cloud

# ---- hosting / DNS / domains (none configured → simulators) ----
WHM_HOST=
WHM_USER=root
WHM_TOKEN=
# WHM_PLAN_PREFIX=gereh_
PDNS_URL=http://127.0.0.1:8081
PDNS_API_KEY=
RC_USER_ID=
RC_API_KEY=
RC_CUSTOMER_ID=
RC_CONTACT_ID=
# RC_SANDBOX=1

# ---- storage ----
# KYC uploads (never served publicly)
KYC_DIR=/var/lib/gereh/kyc
